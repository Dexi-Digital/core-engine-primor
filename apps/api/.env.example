ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://primor:primor@localhost:5432/primor
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed do primeiro admin (idempotente). Setado uma vez no primeiro
# deploy; depois a UI faz o resto. Pode deixar em branco em dev se ja
# tiver criado usuarios manualmente.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador
CORS_ORIGINS=["http://localhost:3000"]

# Object storage (MinIO em dev, S3 em prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=primor-docs

# Outbound email (Resend). Required for D.3 boletins dispatch.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Motor Central <boletins@motorcentral.dev>
PUBLIC_BASE_URL=http://localhost:3000

# D.4 editais storage. Local filesystem em dev; em prod use OneDrive
# (STORAGE_BACKEND=onedrive) ou aponte EDITAIS_STORAGE_PATH para volume
# persistente -- /tmp e wiped a cada reboot do container.
EDITAIS_STORAGE_PATH=/tmp/motor-central/editais

# D.5 LLM analysis. At least one provider must be configured.
# Cost-routed: cheapest first, fallback to the next on error.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# D.6 certidoes / atestados alert recipients (Celery beat task).
# Lista de emails separada por virgula. Ex: licitacoes@primor.com,comercial@primor.com
CERTIDOES_ALERT_EMAILS=

# Modulo A dossie de admissao (opcional). Sem chave, o adapter
# DirectData usa modo mock determinístico.
DIRECTDATA_API_KEY=

# OneDrive / Microsoft Graph (storage de documentos opcional para D.4
# e futuro Modulo A). STORAGE_BACKEND=local (default) usa filesystem;
# STORAGE_BACKEND=onedrive requer as 4 MS_GRAPH_* abaixo (ou cai em
# mock determinístico se faltar alguma).
STORAGE_BACKEND=local
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_DRIVE_ID=
MS_GRAPH_ROOT_FOLDER=MotorCentral/editais

# Modulo C - Domínio Sistemas (Central do Desenvolvedor). Sem
# credenciais, o adapter cai no DominioMockClient deterministico
# para nao bloquear dev/CI -- igual DirectData/LLM/OneDrive.
DOMINIO_AUDIT_URL=
DOMINIO_INTEGRACAO=
DOMINIO_CLIENT_ID=
DOMINIO_CLIENT_SECRET=
DOMINIO_BASE_URL=https://api.dominioexterior.com.br/api/v1
FISCAL_STORAGE_SUBDIR=MotorCentral/fiscal

# Modulo B.3 - Infosimples (consultas Detran SP/MG/GO por placa).
# Sem token, o adapter cai no InfosimplesMockClient deterministico
# -- mesmo padrao DirectData/LLM/OneDrive/Dominio.
INFOSIMPLES_TOKEN=
INFOSIMPLES_BASE_URL=https://api.infosimples.com

# Modulo B.2 - Google Document AI (OCR de Parte Diaria).
# Sem credenciais (qualquer um dos 3 vazio), o adapter cai no
# GoogleDocumentAIMockClient deterministico -- mesmo padrao dos demais.
# Para ligar real:
#   1. Criar service account no GCP com role "Document AI API User".
#   2. Baixar a chave JSON e colar em GOOGLE_DOCUMENTAI_CREDENTIALS_JSON
#      (string unica; escape de \n e ok).
#   3. Criar um processor (recomendo FORM_PARSER_PROCESSOR) e copiar
#      o ID em DOCUMENTAI_PROCESSOR_ID. GCP_PROJECT_ID e o id do projeto.
GOOGLE_DOCUMENTAI_CREDENTIALS_JSON=
GCP_PROJECT_ID=
DOCUMENTAI_PROCESSOR_ID=
DOCUMENTAI_LOCATION=us
PARTE_DIARIA_STORAGE_SUBDIR=MotorCentral/partes-diarias

# Modulo A - OnSafety (SST: ASOs, fichas de EPI, treinamentos).
# Sem token, o adapter cai em modo mock deterministico -- mesmo
# padrao DirectData/Infosimples/Dominio. Tokens NAO sao
# intercambiaveis entre ambientes: o de producao devolve 401 em
# api.dev.*. Default e homologacao; producao = https://api.onsafety.com.br.
ONSAFETY_TOKEN=
ONSAFETY_BASE_URL=https://api.dev.onsafety.com.br
# Guard-rail: escrita contra producao (api.onsafety.com.br) so com
# opt-in explicito -- o token que temos hoje e o de PROD (ADR-001).
ONSAFETY_ALLOW_PROD_WRITE=false
# Estabelecimento/projeto OnSafety do push de onboarding (obrigatorio
# para create_or_update -- sem ele a API deles recusa com 403).
ONSAFETY_PROJETO_ID=

# Modulo A - Tangerino (ponto eletronico — Solides).
# Sem chave, o adapter cai em modo mock deterministico -- mesmo padrao
# DirectData/OnSafety/Dominio.
TANGERINO_API_KEY=
TANGERINO_BASE_URL=https://employer.tangerino.com.br

# Modulo A - Onvio (Dominio/Thomson Reuters — NF-e para o contador).
# Sem qualquer uma das 3 credenciais, o adapter cai em modo mock
# deterministico. ONVIO_ALLOW_SEND=false (default) bloqueia envio real
# com OnvioSendBlockedError; mock nao e afetado.
ONVIO_CLIENT_ID=
ONVIO_CLIENT_SECRET=
ONVIO_INTEGRATION_KEY=
ONVIO_AUDIENCE=409f91f6-dc17-44c8-a5d8-e0a1bafd8b67
ONVIO_ALLOW_SEND=false

# Captador Squad 1: 1 = aprovar um edital despacha
# worker.tasks.licitacoes.processar_edital_aprovado (Squad 2). Mantenha 0
# ate a Squad 2 registrar a task no worker.
CAPTADOR_AUTO_PROCESS=0

# Squad 5: alertas de vencimento de contrato (Celery beat, 08h15,
# 5min apos os afastamentos). Lista de emails separada por virgula.
# Ex: financeiro@primor.com,juridico@primor.com
CONTRATOS_ALERT_EMAILS=

# --- TOTVS RM (Modulo C) ---------------------------------------------
# Ambiente da Primor: TOTVS Cloud (TCloud), HTTPS, 12.1.2510.
# Sem TOTVS_USERNAME/TOTVS_PASSWORD o adapter usa mock deterministico.
# TOTVS_EXTRACTOR: rest | consultasql (default) | mock.
# Leitura direta no banco esta FORA (ambiente e cloud).
TOTVS_BASE_URL=
TOTVS_USERNAME=
TOTVS_PASSWORD=
TOTVS_EXTRACTOR=consultasql
TOTVS_LANCAMENTOS_PATH=/api/fin/v1/lancamentos
TOTVS_CONSULTASQL_COD_SENTENCA=
TOTVS_CONSULTASQL_COD_COLIGADA=1
TOTVS_CONSULTASQL_COD_SISTEMA=F
TOTVS_PULL_DIAS=45
TOTVS_PULL_LOCK_TTL_S=3600

# --- Dominio: chaves de integracao por entidade -----------------------
# Uma chave por empresa (campo `integracao` do POST /token). Hoje o
# adapter le UMA so: DOMINIO_INTEGRACAO. As por-entidade ficam
# registradas para nao se perderem e ja no formato que o suporte
# multi-entidade vai consumir. Valores reais so no .env (gitignored).
DOMINIO_INTEGRACAO_PRIMOR_SOLUCOES=
DOMINIO_INTEGRACAO_CONSTRUTORA_ZAG=
DOMINIO_INTEGRACAO_CONSORCIO_ZAG_GUAXIMA=
# Coligadas que o pull DEVE enxergar (CSV, ex.: "1,2"). O RM filtra em
# silencio quando falta permissao de coligada -- confirmado pela TOTVS
# em 27/08/2026. Vazio = guarda desligada.
TOTVS_COLIGADAS_ESPERADAS=

# --- Solides Ponto / Tangerino (Modulos A e B) ------------------------
# Token de integracao: painel > Empregador > Integracoes. Sem ele, o
# adapter usa mock deterministico. A Solides entrega o valor com o
# prefixo "Basic "; o adapter repassa como veio (funciona dos dois jeitos).
TANGERINO_API_KEY=
TANGERINO_BASE_URL=https://employer.tangerino.com.br
PONTO_PULL_DIAS=45
PONTO_PULL_LOCK_TTL_S=7200
