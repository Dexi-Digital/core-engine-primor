ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://primor:primor@localhost:5432/primor
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]

# Object storage (MinIO em dev, S3 em prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=primor-docs

# Outbound email (Resend). Required for D.3 boletins dispatch.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Motor Central <boletins@motorcentral.dev>
PUBLIC_BASE_URL=http://localhost:3000
